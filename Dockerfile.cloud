FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    BUGHUNTER_DATA_DIR=/app/data

WORKDIR /app

COPY requirements-cloud.txt ./requirements-cloud.txt
RUN python -m pip install --upgrade pip \
    && pip install -r requirements-cloud.txt

COPY app ./app
COPY config ./config
COPY data ./data

RUN mkdir -p /app/data /app/data/evidence \
    && useradd --create-home --uid 10001 bughunter \
    && chown -R bughunter:bughunter /app

USER bughunter

EXPOSE 8765

CMD ["uvicorn", "app.api.server:app", "--host", "0.0.0.0", "--port", "8765"]
