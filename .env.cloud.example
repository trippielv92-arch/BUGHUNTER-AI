# Copy to .env on the cloud host and replace every example value.
POSTGRES_DB=bughunter
POSTGRES_USER=bughunter
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
BUGHUNTER_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BUGHUNTER_DATABASE_URL=postgresql+psycopg://bughunter:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/bughunter
BUGHUNTER_DATA_DIR=/app/data
# Optional until controlled test-account profiles are used.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and stable; the worker and API must use the same key.
BUGHUNTER_CREDENTIAL_ENCRYPTION_KEY=
